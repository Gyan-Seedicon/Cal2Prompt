# ==============================================================================
# Google Service Account Credentials
# (Spreadsheet(s) must be shared with this service account email with Viewer role)
# ==============================================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# OPTION A: 4 Products across 4 Spreadsheets (Config Array JSON or Individual Vars)
# ==============================================================================
# Option A1: JSON Config Array (Recommended for 4 separate sheets)
GOOGLE_SHEETS_CONFIG='[{"productName":"Product A","spreadsheetId":"1xxxxxxA"},{"productName":"Product B","spreadsheetId":"1xxxxxxB"},{"productName":"Product C","spreadsheetId":"1xxxxxxC"},{"productName":"Product D","spreadsheetId":"1xxxxxxD"}]'

# Option A2: Individual Product Variables
# GOOGLE_SHEET_PRODUCT_1_NAME=Product A
# GOOGLE_SHEET_PRODUCT_1_ID=1xxxxxxA
# GOOGLE_SHEET_PRODUCT_2_NAME=Product B
# GOOGLE_SHEET_PRODUCT_2_ID=1xxxxxxB
# GOOGLE_SHEET_PRODUCT_3_NAME=Product C
# GOOGLE_SHEET_PRODUCT_3_ID=1xxxxxxC
# GOOGLE_SHEET_PRODUCT_4_NAME=Product D
# GOOGLE_SHEET_PRODUCT_4_ID=1xxxxxxD

# ==============================================================================
# OPTION B: Single Spreadsheet with Multiple Tabs
# ==============================================================================
# GOOGLE_SHEET_ID=your_single_spreadsheet_id_here
# GOOGLE_SHEET_TABS=Product A,Product B,Product C,Product D

# Set to true to force realistic mock data even if live credentials are configured
USE_MOCK_SHEETS=false
